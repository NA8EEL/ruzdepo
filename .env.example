# ─────────────────────────────────────────────────────────────────────────────
# RUZ Interiors — Environment Variables Reference
# Copy this file to .env and fill in the values before running locally.
# NEVER commit the .env file to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Admin credentials ────────────────────────────────────────────────────────
# Leave blank to use the built-in defaults (nihal / nihal@ruz)
ADMIN_USERNAME=nihal
ADMIN_PASSWORD=nihal@ruz

# ── Session ──────────────────────────────────────────────────────────────────
# Set a long random string in production (Render auto-generates one)
SESSION_SECRET=change-me-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (local development, no extra setup needed)
# Set to your PostgreSQL connection string in production:
#   postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=

# ── Cloud Storage (Cloudinary) ────────────────────────────────────────────────
# Leave empty to store uploads on local disk.
# Copy your CLOUDINARY_URL from: https://console.cloudinary.com → Dashboard
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# ─── OR use individual variables instead of CLOUDINARY_URL ───────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
